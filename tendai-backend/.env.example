# Copy to .env and fill in real values. Never commit .env.

# Required for Talk / Feed advice (Google AI Studio or Cloud)
GOOGLE_API_KEY=your-google-ai-api-key-here

# Listen port (Render/Railway/Fly set PORT automatically)
PORT=3001

# production | development (production CORS denies unknown origins)
NODE_ENV=development

# Comma-separated browser origins allowed to call the relay (required in production)
# Example: https://obrium.example,https://www.obrium.example
OBRIUM_ALLOWED_ORIGINS=

# Trust X-Forwarded-For from the reverse proxy so per-IP rate limits see the real client.
# Local default: unset/false. On Render/Railway/Fly behind one proxy: 1
OBRIUM_TRUST_PROXY=0

# Model and output caps
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=640
GEMINI_FEED_MAX_OUTPUT_TOKENS=2048

# Upstream Gemini call timeout (ms)
OBRIUM_UPSTREAM_TIMEOUT_MS=25000

# Request limits
OBRIUM_MAX_BODY_BYTES=32768
OBRIUM_MAX_MESSAGE_LENGTH=2000
OBRIUM_RATE_LIMIT_PER_IP=30
OBRIUM_RATE_LIMIT_WINDOW_MS=60000
OBRIUM_DAILY_REQUEST_CAP=2000
