# Serron Backend — Copy this file to .env and add your API key
# cp .env.example .env

GOOGLE_API_KEY=your-google-ai-api-key-here
# Use 3001 by default (repo `npm start` serves mobile-app on 3000)
PORT=3001
# gemini-1.5-flash is not available for many API keys (404). Use a model from ListModels, e.g. gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
